{
  "name": "@math-concepts-made-easy/remotion",
  "version": "0.1.0",
  "description": "Isolated Remotion development shell; no production publishing or Manim timeline integration",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "bundle": "remotion bundle src/index.ts --out-dir=build/scaffold"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "remotion": "4.0.537",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.537",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0"
  }
}
